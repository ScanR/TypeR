{
  "manifestVersion": 5,
  "id": "com.scanr.typer",
  "name": "TypeR",
  "version": "0.0.0",
  "main": "index.html",
  "host": {
    "app": "PS",
    "minVersion": "26.0.0",
    "data": { "apiVersion": 2 }
  },
  "icons": [
    { "width": 23, "height": 23, "path": "icons/iconDarkNormal.png", "scale": [1, 2], "theme": ["darkest", "dark", "medium"], "species": ["pluginList"] },
    { "width": 23, "height": 23, "path": "icons/iconNormal.png", "scale": [1, 2], "theme": ["lightest", "light"], "species": ["pluginList"] }
  ],
  "entrypoints": [
    {
      "type": "panel",
      "id": "typer",
      "label": { "default": "TypeR" },
      "minimumSize": { "width": 250, "height": 300 },
      "maximumSize": { "width": 800, "height": 9999 },
      "preferredDockedSize": { "width": 600, "height": 900 },
      "preferredFloatingSize": { "width": 600, "height": 900 },
      "icons": [
        { "width": 23, "height": 23, "path": "icons/iconDarkNormal.png", "scale": [1, 2], "theme": ["darkest", "dark", "medium"], "species": ["chrome"] },
        { "width": 23, "height": 23, "path": "icons/iconNormal.png", "scale": [1, 2], "theme": ["lightest", "light"], "species": ["chrome"] }
      ]
    }
  ],
  "requiredPermissions": {
    "localFileSystem": "fullAccess",
    "network": { "domains": "all" },
    "launchProcess": { "schemes": ["http", "https", "mailto"], "extensions": [".ccx", ".zip", ".psd", ".json", ""] },
    "clipboard": "readAndWrite",
    "webview": {
      "allow": "yes",
      "domains": "all",
      "allowLocalRendering": "yes",
      "enableMessageBridge": "localOnly"
    }
  }
}
